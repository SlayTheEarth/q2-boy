diff --git a/patch/boy_display.h b/patch/boy_display.h
new file mode 100644
index 0000000..a20cb74
--- /dev/null
+++ b/patch/boy_display.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#define BOY_DISPLAY_REQUEST "/tmp/q2-boy.display.req"
+#define BOY_DISPLAY_DIMMED "/tmp/q2-boy.display.dimmed"
+
+static void boy_display_restore(void) {
+    if (!gm.display_dimmed) return;
+    gm.display_dimmed = 0;
+    if (g_backlight_status) toolSetBackLight(g_lightness + 1);
+    unlink(BOY_DISPLAY_DIMMED);
+}
+
+static void boy_display_end(void) {
+    boy_display_restore();
+    unlink(BOY_DISPLAY_REQUEST);
+    unlink(BOY_DISPLAY_DIMMED);
+}
+
+static void boy_display_poll(unsigned now) {
+    if (!gm.boy_bridge) return;
+    if (gm.native_ui || !g_backlight_status) {
+        boy_display_restore();
+        return;
+    }
+    if (gm.display_poll && now - gm.display_poll < (gm.display_dimmed ? 80u : 250u))
+        return;
+    gm.display_poll = now;
+    char requested;
+    if (BLOB_IO(BOY_DISPLAY_REQUEST, requested, 0) && requested == '1') {
+        /* Stock brightness is zero-based. 1 is the minimum lit setting. */
+        if (!gm.display_dimmed && g_lightness &&
+            BLOB_IO(BOY_DISPLAY_DIMMED, requested, 1)) {
+            toolSetBackLight(1);
+            gm.display_dimmed = 1;
+        }
+    } else {
+        boy_display_restore();
+    }
+}
